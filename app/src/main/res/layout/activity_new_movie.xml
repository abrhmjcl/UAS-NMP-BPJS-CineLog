<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/lblFormHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Film Baru"
            android:textColor="@color/red_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutInputTitle"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Judul Film"
            android:textColorHint="@color/red_primary"
            app:boxStrokeColor="@color/red_primary"
            app:hintTextColor="@color/red_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtInputTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/red_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pilih Genre:"
            android:textColor="@color/red_primary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinnerGenre"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Platform Penayangan:"
            android:textColor="@color/red_primary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinnerPlatform"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Klasifikasi Usia:"
            android:textColor="@color/red_primary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgAgeRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSU"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="SU"
                android:textColor="@color/red_primary"
                app:buttonTint="@color/red_primary" />

            <RadioButton
                android:id="@+id/rb13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="13+"
                android:textColor="@color/red_primary"
                app:buttonTint="@color/red_primary" />

            <RadioButton
                android:id="@+id/rb17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="17+"
                android:textColor="@color/red_primary"
                app:buttonTint="@color/red_primary" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutInputUrl"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="URL Poster Gambar (Enter untuk Preview)"
            android:textColorHint="@color/red_primary"
            app:boxStrokeColor="@color/red_primary"
            app:hintTextColor="@color/red_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtInputUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:textColor="@color/red_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCapturePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/red_primary"
                android:text="Ambil Foto (Kamera)"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="atau isi URL di atas"
                android:textColor="@color/red_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgFormPreview"
            android:layout_width="120dp"
            android:layout_height="175dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            android:scaleType="centerCrop" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutInputTrailer"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="URL Trailer YouTube"
            android:textColorHint="@color/red_primary"
            app:boxStrokeColor="@color/red_primary"
            app:hintTextColor="@color/red_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtInputTrailer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/red_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutInputRating"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Rating Skor (1.0 - 10.0)"
            android:textColorHint="@color/red_primary"
            app:boxStrokeColor="@color/red_primary"
            app:hintTextColor="@color/red_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtInputRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/red_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutInputReview"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Ulasan Film"
            android:textColorHint="@color/red_primary"
            app:boxStrokeColor="@color/red_primary"
            app:hintTextColor="@color/red_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtInputReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:lines="3"
                android:textColor="@color/red_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbIsWatched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Sudah Ditonton"
            android:textColor="@color/red_primary"
            app:buttonTint="@color/red_primary" />

        <CheckBox
            android:id="@+id/cbHasSpoilers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ulasan Mengandung Spoiler"
            android:textColor="@color/red_primary"
            app:buttonTint="@color/red_primary" />

        <CheckBox
            android:id="@+id/cbIsFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambahkan ke Favorites"
            android:textColor="@color/red_primary"
            app:buttonTint="@color/red_primary" />

        <Button
            android:id="@+id/btnSubmitMovie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/red_primary"
            android:text="Simpan Film"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>